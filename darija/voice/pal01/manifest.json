  {
   "id": "i1",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "السلام عليكم! أهلا وسهلا فيكم.",
   "characters": 30,
   "model": "eleven_v4",
   "seconds": 2.8
  },
  {
   "id": "i2",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "اليوم رح نتعلم إنجليزي، خطوة خطوة.",
   "characters": 34,
   "model": "eleven_v4",
   "seconds": 3.52
  },
  {
   "id": "i3",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "يلا، نبلش!",
   "characters": 10,
   "model": "eleven_v4",
   "seconds": 1.6
  },
  {
   "id": "p01t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "مرحبا، كيفك؟",
   "characters": 12,
   "model": "eleven_v4",
   "seconds": 1.76
  },
  {
   "id": "p01k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "Hi, how are you?",
   "characters": 16,
   "model": "eleven_v4",
   "seconds": 1.76
  },
  {
   "id": "p02t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "منيح، الحمد لله.",
   "characters": 16,
   "model": "eleven_v4",
   "seconds": 1.84
  },
  {
   "id": "p02k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "I'm fine, thank you.",
   "characters": 20,
   "model": "eleven_v4",
   "seconds": 1.92
  },
  {
   "id": "p03t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "شو اسمك؟",
   "characters": 8,
   "model": "eleven_v4",
   "seconds": 1.12
  },
  {
   "id": "p03k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "What's your name?",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 1.12
  },
  {
   "id": "p04t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "اسمي لينا.",
   "characters": 10,
   "model": "eleven_v4",
   "seconds": 1.04
  },
  {
   "id": "p04k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "My name is Lina.",
   "characters": 16,
   "model": "eleven_v4",
   "seconds": 1.84
  },
  {
   "id": "p05t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "من وين إنت؟",
   "characters": 11,
   "model": "eleven_v4",
   "seconds": 1.12
  },
  {
   "id": "p05k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "Where are you from?",
   "characters": 19,
   "model": "eleven_v4",
   "seconds": 1.36
  },
  {
   "id": "p06t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "بدي مي، من فضلك.",
   "characters": 16,
   "model": "eleven_v4",
   "seconds": 1.84
  },
  {
   "id": "p06k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "I want water, please.",
   "characters": 21,
   "model": "eleven_v4",
   "seconds": 2.08
  },
  {
   "id": "p07t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "قديش هاد؟",
   "characters": 9,
   "model": "eleven_v4",
   "seconds": 1.12
  },
  {
   "id": "p07k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "How much is this?",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 1.44
  },
  {
   "id": "p08t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "وين الحمام؟",
   "characters": 11,
   "model": "eleven_v4",
   "seconds": 1.28
  },
  {
   "id": "p08k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "Where is the bathroom?",
   "characters": 22,
   "model": "eleven_v4",
   "seconds": 1.84
  },
  {
   "id": "p09t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "ما فهمت.",
   "characters": 8,
   "model": "eleven_v4",
   "seconds": 1.12
  },
  {
   "id": "p09k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "I don't understand.",
   "characters": 19,
   "model": "eleven_v4",
   "seconds": 1.68
  },
  {
   "id": "p10t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
   "text": "عيدها، لو سمحت.",
   "characters": 15,
   "model": "eleven_v4",
   "seconds": 1.76
  },
  {
   "id": "p10k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "Say it again, please.",
   "characters": 21,
   "model": "eleven_v4",
   "seconds": 1.76
  },
  {
   "id": "p11t",
   "speaker": "T",
   "voice": "jAAHNNqlbAX9iWjJPEtE",
