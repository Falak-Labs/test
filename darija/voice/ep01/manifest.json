  {
   "id": "p01t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "سلام، لاباس؟",
   "characters": 12,
   "model": "eleven_v4",
   "seconds": 1.76
  },
  {
   "id": "p01k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "Hi, how are you?",
   "characters": 16,
   "model": "eleven_v4",
   "seconds": 1.76
  },
  {
   "id": "p02t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "لاباس، الحمد لله.",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 2.0
  },
  {
   "id": "p02k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "I'm fine, thank you.",
   "characters": 20,
   "model": "eleven_v4",
   "seconds": 1.92
  },
  {
   "id": "p03t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "شنو سميتك؟",
   "characters": 10,
   "model": "eleven_v4",
   "seconds": 1.28
  },
  {
   "id": "p03k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "What's your name?",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 1.12
  },
  {
   "id": "p04t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "سميتي لينا.",
   "characters": 11,
   "model": "eleven_v4",
   "seconds": 1.28
  },
  {
   "id": "p04k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "My name is Lina.",
   "characters": 16,
   "model": "eleven_v4",
   "seconds": 1.84
  },
  {
   "id": "p05t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "منين نتا؟",
   "characters": 9,
   "model": "eleven_v4",
   "seconds": 1.12
  },
  {
   "id": "p05k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "Where are you from?",
   "characters": 19,
   "model": "eleven_v4",
   "seconds": 1.36
  },
  {
   "id": "p06t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "بغيت الما، عافاك.",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 1.76
  },
  {
   "id": "p06k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "I want water, please.",
   "characters": 21,
   "model": "eleven_v4",
   "seconds": 2.08
  },
  {
   "id": "p07t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "بشحال هادا؟",
   "characters": 11,
   "model": "eleven_v4",
   "seconds": 1.28
  },
  {
   "id": "p07k",
   "speaker": "A",
   "voice": "XjGYkUkzth8BPs29fmcV",
   "text": "How much is this?",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 1.44
  },
  {
   "id": "p08t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "فين كاين بيت الما؟",
   "characters": 18,
   "model": "eleven_v4",
   "seconds": 1.52
  },
  {
   "id": "p08k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "Where is the bathroom?",
   "characters": 22,
   "model": "eleven_v4",
   "seconds": 1.84
  },
  {
   "id": "p09t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "ما فهمتش.",
