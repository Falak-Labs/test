  {
   "id": "h1",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "سلام! واش كتعرف تقول مبروك بالإنجليزية؟",
   "characters": 39,
   "model": "eleven_v4",
   "seconds": 3.92
  },
  {
   "id": "h2",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "الجواب فالآخر. يالله!",
   "characters": 21,
   "model": "eleven_v4",
   "seconds": 2.24
  },
  {
   "id": "p01t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "سلام، لاباس؟",
   "characters": 12,
   "model": "eleven_v4",
   "seconds": 1.84
  },
  {
   "id": "p01k",
   "speaker": "A",
   "voice": "tJHJUEHzOkMoPmJJ5jo2",
   "text": "Hi, how are you?",
   "characters": 16,
   "model": "eleven_v4",
   "seconds": 1.68
  },
  {
   "id": "p02t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "لاباس، الحمد لله.",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 2.0
  },
  {
   "id": "p02k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "I'm fine, thank you.",
   "characters": 20,
   "model": "eleven_v4",
   "seconds": 1.84
  },
  {
   "id": "p03t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "شنو سميتك؟",
   "characters": 10,
   "model": "eleven_v4",
   "seconds": 1.28
  },
  {
   "id": "p03k",
   "speaker": "A",
   "voice": "tJHJUEHzOkMoPmJJ5jo2",
   "text": "What's your name?",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 1.04
  },
  {
   "id": "p04t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "سميتي لينا.",
   "characters": 11,
   "model": "eleven_v4",
   "seconds": 1.28
  },
  {
   "id": "p04k",
   "speaker": "L",
   "voice": "Nggzl2QAXh3OijoXD116",
   "text": "My name is Lina.",
   "characters": 16,
   "model": "eleven_v4",
   "seconds": 1.68
  },
  {
   "id": "p05t",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
   "text": "أنا من المغرب.",
   "characters": 14,
   "model": "eleven_v4",
   "seconds": 1.68
  },
  {
   "id": "p05k",
   "speaker": "A",
   "voice": "tJHJUEHzOkMoPmJJ5jo2",
   "text": "I'm from Morocco.",
   "characters": 17,
   "model": "eleven_v4",
   "seconds": 1.52
  },
  {
   "id": "r0",
   "speaker": "T",
   "voice": "OfGMGmhShO8iL9jCkXy8",
